---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Draft copy carried over from the approved design-preview mockup
// (docs/design-previews/palette-comparison.html). Not yet locked as final —
// PROJECT.md > Brief > Feel is still blocking on client confirmation, and no
// hero headline was formally recorded under Design direction. Marked draft
// on-page until that's resolved, per instructions.md truth rules.
const heroHeadline = {
	lead: 'Raw footage in.',
	emphasis: 'Real momentum out.',
};

const stages = [
	{ code: '00:00:00:00', label: 'Ingest & editorial map', body: 'Bins organized, selects marked, the story shape agreed before a single cut is made.' },
	{ code: '00:18:12:08', label: 'Story assembly & pacing', body: 'A trimmed assembly cut carries the narrative — proxies fast enough to keep pace with notes.' },
	{ code: '01:04:42:16', label: 'Color, sound & motion', body: 'Grade, mix, and motion pass together so nothing fights for attention in the final conform.' },
	{ code: '01:18:24:12', label: 'Masters & cutdowns', body: 'Delivery masters and every aspect-ratio cutdown, captioned and ready to publish.' },
];

const workPreview = [
	{ format: '16:9', label: 'Case study pending' },
	{ format: '1:1', label: 'Case study pending' },
	{ format: '9:16', label: 'Case study pending' },
];
---

<BaseLayout
	title="Home"
	description="CreatersDen is a video-editing and post-production partner for brand, tech, and creator teams — from raw footage to delivery masters."
>
	<section class="hero">
		<div class="hero__statement">
			<p class="hero__eyebrow">Post-production, run like a workroom</p>
			<h1 class="hero__headline">
				{heroHeadline.lead}
				<em>{heroHeadline.emphasis}</em>
				<span class="draft-tag" aria-hidden="true">Draft copy</span>
			</h1>
			<p class="hero__body">
				We shape pace, picture, sound, and motion into edits people finish — organized from first
				proxy to final master, across every ratio a campaign actually needs.
			</p>
			<div class="hero__actions">
				<a class="button button--primary" href={`${base}/estimate/`}>Scope your edit</a>
				<a class="button button--secondary" href={`${base}/work/`}>See selected work</a>
			</div>
		</div>

		<ol class="timeline" aria-label="Editorial process overview">
			{
				stages.map((stage) => (
					<li class="timeline__stage">
						<span class="timeline__code">{stage.code}</span>
						<p class="timeline__label">{stage.label}</p>
						<p class="timeline__body">{stage.body}</p>
					</li>
				))
			}
		</ol>
	</section>

	<section class="proof" aria-labelledby="proof-heading">
		<div class="proof__head">
			<h2 id="proof-heading">Recent cuts</h2>
			<a class="proof__link" href={`${base}/work/`}>View the full work index →</a>
		</div>
		<ul class="proof__grid">
			{
				workPreview.map((item) => (
					<li class="proof__card" data-format={item.format}>
						<span class="proof__ratio">{item.format}</span>
						<p class="proof__pending">{item.label}</p>
					</li>
				))
			}
		</ul>
		<p class="proof__note">
			Portfolio media has not been supplied yet. These frames are placeholders and are not client
			work — see <a href={`${base}/work/`}>Work</a> once real proxies are added.
		</p>
	</section>

	<section class="cta-band" aria-labelledby="cta-heading">
		<h2 id="cta-heading">Four questions. One scoped turnaround band.</h2>
		<p>
			The estimator classifies scope and gives a provisional turnaround band — no invented pricing,
			no sales call required to find out if this is a fit.
		</p>
		<a class="button button--primary" href={`${base}/estimate/`}>Start the estimator</a>
	</section>
</BaseLayout>

<style>
	.hero {
		max-width: var(--content-max);
		margin-inline: auto;
		padding: var(--space-2xl) var(--space-sm) var(--space-lg);
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: var(--space-xl);
		align-items: start;
	}

	.hero__eyebrow {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--color-accent-secondary);
		margin-bottom: var(--space-sm);
	}

	.hero__headline {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: var(--step-5);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-display);
		text-transform: uppercase;
		margin: 0 0 var(--space-md);
	}

	.hero__headline em {
		display: block;
		font-style: normal;
		color: var(--color-accent);
	}

	.draft-tag {
		display: inline-block;
		margin-left: var(--space-xs);
		padding: 0.2rem 0.5rem;
		border: 1px solid var(--color-text-muted);
		border-radius: 999px;
		font-family: var(--font-mono);
		font-size: 0.55rem;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--color-text-muted);
		vertical-align: middle;
	}

	.hero__body {
		max-width: 52ch;
		font-size: var(--step-1);
		line-height: var(--leading-normal);
		color: var(--color-text-muted);
		margin-bottom: var(--space-md);
	}

	.hero__actions {
		display: flex;
		gap: var(--space-xs);
		flex-wrap: wrap;
	}

	.button {
		display: inline-flex;
		align-items: center;
		min-height: 48px;
		padding: 0 var(--space-sm);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
		border-radius: var(--radius-sm);
		border: 1px solid transparent;
		transition:
			background-color var(--duration-cut) var(--ease-cut),
			border-color var(--duration-cut) var(--ease-cut);
	}

	.button--primary {
		background: var(--color-accent);
		color: var(--color-bg);
	}

	.button--primary:hover {
		background: color-mix(in srgb, var(--color-accent) 85%, white);
	}

	.button--secondary {
		border-color: var(--color-line);
		color: var(--color-text);
	}

	.button--secondary:hover {
		border-color: var(--color-text-muted);
	}

	/* ---- Timeline (signature element) ---- */
	.timeline {
		list-style: none;
		margin: 0;
		padding: 0 0 0 var(--space-md);
		border-left: 2px solid var(--color-accent);
		display: grid;
		gap: var(--space-md);
	}

	.timeline__stage {
		position: relative;
	}

	.timeline__stage::before {
		content: '';
		position: absolute;
		/* -2.8125rem = -(--space-md's 2.5rem + half the 10px dot), centering the
		   marker on the 2px border-left line. Written as a literal rather than
		   calc(-1 * var(--space-md) - 5px) — same value, cheaper to verify, and
		   update this if --space-md's multiplier in tokens.css ever changes. */
		left: -2.8125rem;
		top: 0.35rem;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--color-accent);
	}

	.timeline__stage:nth-child(2)::before {
		background: var(--color-accent-secondary);
	}

	.timeline__stage:nth-child(3)::before {
		background: var(--color-accent-tertiary);
	}

	.timeline__stage:nth-child(4)::before {
		background: var(--color-text-muted);
	}

	.timeline__code {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: var(--tracking-label);
		color: var(--color-accent);
	}

	.timeline__label {
		font-family: var(--font-sans);
		font-weight: 600;
		margin: var(--space-2xs) 0;
	}

	.timeline__body {
		font-size: 0.9rem;
		color: var(--color-text-muted);
		max-width: 40ch;
	}

	/* ---- Proof / work preview ---- */
	.proof {
		max-width: var(--content-max);
		margin-inline: auto;
		padding: var(--space-lg) var(--space-sm);
		border-top: 1px solid var(--color-line);
	}

	.proof__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: var(--space-xs);
		margin-bottom: var(--space-md);
	}

	.proof__head h2 {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: var(--step-3);
	}

	.proof__link {
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 0.85rem;
		text-decoration: none;
		color: var(--color-accent-secondary);
		white-space: nowrap;
	}

	.proof__grid {
		list-style: none;
		margin: 0 0 var(--space-sm);
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-sm);
	}

	.proof__card {
		min-width: 0; /* without this, aspect-ratio + grid's default min-width:auto let this item overflow its 1fr track — confirmed live: was rendering ~1213px wide instead of ~384px, causing page-wide horizontal overflow */
		aspect-ratio: 16 / 9;
		background: var(--color-surface);
		border: 1px dashed var(--color-line);
		border-radius: var(--radius-sm);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--space-2xs);
		padding: var(--space-sm);
		text-align: center;
	}

	.proof__card[data-format='1:1'] {
		aspect-ratio: 1 / 1;
	}

	.proof__card[data-format='9:16'] {
		aspect-ratio: 9 / 16;
	}

	.proof__ratio {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--color-text-muted);
	}

	.proof__pending {
		font-family: var(--font-sans);
		font-size: 0.85rem;
		color: var(--color-text-muted);
	}

	.proof__note {
		font-size: 0.8rem;
		color: var(--color-text-muted);
	}

	.proof__note a {
		color: var(--color-accent-secondary);
	}

	/* ---- CTA band ---- */
	.cta-band {
		max-width: var(--content-max);
		margin-inline: auto;
		padding: var(--space-2xl) var(--space-sm);
		text-align: center;
		display: grid;
		gap: var(--space-sm);
		justify-items: center;
	}

	.cta-band h2 {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: var(--step-3);
		letter-spacing: var(--tracking-display);
		text-transform: uppercase;
		max-width: 22ch;
	}

	.cta-band p {
		max-width: 48ch;
		color: var(--color-text-muted);
	}

	@media (max-width: 860px) {
		.hero {
			grid-template-columns: 1fr;
			padding-top: var(--space-xl);
		}

		.proof__grid {
			grid-template-columns: 1fr 1fr;
		}

		.proof__grid li:nth-child(3) {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 520px) {
		.proof__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
