---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Draft copy carried over from the approved design-preview mockup
// (docs/design-previews/palette-comparison.html). Not yet locked as final —
// PROJECT.md > Brief > Feel is confirmed, but no hero headline was formally
// recorded under Design direction. Marked draft on-page until that's resolved,
// per instructions.md truth rules.
const heroHeadline = {
	lead: 'Raw footage in.',
	emphasis: 'Real momentum out.',
};

const heroMetrics = [
	{ value: 'One brief', label: 'A coherent edit system' },
	{ value: 'Every ratio', label: '9:16 · 1:1 · 16:9' },
	{ value: 'One handoff', label: 'Organized final masters' },
];

const stages = [
	{ code: '00:00:00:00', label: 'Ingest & editorial map', body: 'Bins organized, selects marked, the story shape agreed before a single cut is made.' },
	{ code: '00:18:12:08', label: 'Story assembly & pacing', body: 'A trimmed assembly cut carries the narrative — proxies fast enough to keep pace with notes.' },
	{ code: '01:04:42:16', label: 'Color, sound & motion', body: 'Grade, mix, and motion pass together so nothing fights for attention in the final conform.' },
	{ code: '01:18:24:12', label: 'Masters & cutdowns', body: 'Delivery masters and every aspect-ratio cutdown, captioned and ready to publish.' },
];

// Capability framing derived from language already approved in HANDOFF.md's process
// description — not a fabricated service menu. PROJECT.md > Content inventory still
// lists a real client-supplied service list as needed; this is a provisional stand-in
// to be overridden once that arrives, not presented as pricing or packaging.
const capabilities = [
	{ n: '01', title: 'Editing & story assembly', body: 'Raw footage organized into a trimmed assembly cut that carries the narrative.' },
	{ n: '02', title: 'Color grading', body: 'A grade that reads consistently across every delivery format.' },
	{ n: '03', title: 'Sound design & mix', body: 'Sound design and mix passed alongside the edit, not bolted on after.' },
	{ n: '04', title: 'Motion & graphics', body: 'Titles, lower-thirds, and motion that support the cut instead of competing with it.' },
	{ n: '05', title: 'Multi-format delivery', body: 'Delivery masters and every aspect-ratio cutdown, captioned and ready to publish.' },
];

const workPreview = [
	{ format: '16:9', label: 'Case study pending' },
	{ format: '1:1', label: 'Case study pending' },
	{ format: '9:16', label: 'Case study pending' },
];
---

<BaseLayout
	title="Home"
	description="CreatersDen is a video-editing and post-production partner for brand, tech, and creator teams — from raw footage to delivery masters."
>
	<!-- 1. Hero — dark. Cinematic entrance, signature timeline element. -->
	<section class="hero">
		<div class="hero__grid">
			<div class="hero__statement">
				<p class="eyebrow eyebrow--dark">Post-production, run like a workroom</p>
				<h1 class="hero__headline">
					{heroHeadline.lead}
					<em>{heroHeadline.emphasis}</em>
					<span class="draft-tag" aria-hidden="true">Draft copy</span>
				</h1>
				<p class="hero__body">
					We shape pace, picture, sound, and motion into edits people finish — organized from first
					proxy to final master, across every ratio a campaign actually needs.
				</p>
				<div class="hero__actions">
					<a class="button button--primary" href={`${base}/estimate/`}>Scope your edit</a>
					<a class="button button--secondary" href={`${base}/work/`}>See selected work</a>
				</div>
			</div>

			<ol class="timeline" aria-label="Editorial process overview">
				{
					stages.map((stage) => (
						<li class="timeline__stage">
							<span class="timeline__code">{stage.code}</span>
							<p class="timeline__label">{stage.label}</p>
							<p class="timeline__body">{stage.body}</p>
						</li>
					))
				}
			</ol>
		</div>

		<ul class="hero__metrics">
			{
				heroMetrics.map((m) => (
					<li class="hero__metric">
						<strong>{m.value}</strong>
						<span>{m.label}</span>
					</li>
				))
			}
		</ul>
	</section>

	<!-- 2. Capabilities — light. Informational, benefits from readability/trust. -->
	<section class="capabilities" data-surface="light" aria-labelledby="capabilities-heading">
		<div class="section-inner">
			<p class="eyebrow eyebrow--light">What we do</p>
			<h2 id="capabilities-heading" class="capabilities__heading">Capabilities</h2>
			<ol class="capabilities__list">
				{
					capabilities.map((c) => (
						<li class="capabilities__item">
							<span class="capabilities__n">{c.n}</span>
							<div>
								<h3>{c.title}</h3>
								<p>{c.body}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- 3. Work showcase — dark. Visual work reads best against a dark canvas. -->
	<section class="proof" aria-labelledby="proof-heading">
		<div class="section-inner">
			<p class="eyebrow eyebrow--dark">Selected work</p>
			<div class="proof__head">
				<h2 id="proof-heading">Recent cuts</h2>
				<a class="proof__link" href={`${base}/work/`}>View the full work index →</a>
			</div>
			<ul class="proof__grid">
				{
					workPreview.map((item) => (
						<li class="proof__card" data-format={item.format}>
							<span class="proof__ratio">{item.format}</span>
							<p class="proof__pending">{item.label}</p>
						</li>
					))
				}
			</ul>
			<p class="proof__note">
				Portfolio media has not been supplied yet. These frames are placeholders and are not client
				work — see <a href={`${base}/work/`}>Work</a> once real proxies are added.
			</p>
		</div>
	</section>

	<!-- 4. About/team teaser — light. Humanizing, trust-building. -->
	<section class="about-teaser" data-surface="light" aria-labelledby="about-heading">
		<div class="section-inner about-teaser__inner">
			<div>
				<p class="eyebrow eyebrow--light">Who we are</p>
				<h2 id="about-heading">About the studio</h2>
				<p class="about-teaser__body">
					CreatersDen is a video-editing and post-production partner for DTC brand teams, tech and
					SaaS marketers, content creators, and advertising agencies who need a reliable partner for
					finishing work, not just cutting it.
				</p>
				<p class="about-teaser__pending">Team bios and studio story are being written up — check back soon.</p>
				<a class="text-link" href={`${base}/about/`}>More about the studio →</a>
			</div>
		</div>
	</section>

	<!-- 5. Estimator CTA — dark. Strong, energetic close. -->
	<section class="cta-band" aria-labelledby="cta-heading">
		<p class="eyebrow eyebrow--dark">Get started</p>
		<h2 id="cta-heading">Four questions. One scoped turnaround band.</h2>
		<p>
			The estimator classifies scope and gives a provisional turnaround band — no invented pricing,
			no sales call required to find out if this is a fit.
		</p>
		<a class="button button--primary" href={`${base}/estimate/`}>Start the estimator</a>
	</section>
</BaseLayout>

<style>
	.section-inner {
		max-width: var(--content-max);
		margin-inline: auto;
		padding: var(--space-2xl) var(--space-sm);
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		margin-bottom: var(--space-sm);
	}

	/* Accent color as eyebrow text only ever appears on the DARK surface, where it
	   clears contrast (steel 7.15:1 on graphite). On light sections the same accent
	   fails contrast (steel 2.22:1 on projector white — see tokens.css/base.css), so
	   light-surface eyebrows use the surface-aware muted tone instead, never an accent. */
	.eyebrow--dark {
		color: var(--color-accent-secondary);
	}

	.eyebrow--light {
		color: var(--surface-text-muted);
		font-weight: 600;
	}

	/* ---- 1. Hero ---- */
	.hero {
		padding-top: var(--space-2xl);
	}

	.hero__grid {
		max-width: var(--content-max);
		margin-inline: auto;
		padding: 0 var(--space-sm) var(--space-lg);
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: var(--space-xl);
		align-items: start;
	}

	.hero__headline {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: var(--step-5);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-display);
		text-transform: uppercase;
		margin: 0 0 var(--space-md);
	}

	.hero__headline em {
		display: block;
		font-style: normal;
		color: var(--color-accent);
	}

	.draft-tag {
		display: inline-block;
		margin-left: var(--space-xs);
		padding: 0.2rem 0.5rem;
		border: 1px solid var(--surface-text-muted);
		border-radius: 999px;
		font-family: var(--font-mono);
		font-size: 0.55rem;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--surface-text-muted);
		vertical-align: middle;
	}

	.hero__body {
		max-width: 52ch;
		font-size: var(--step-1);
		line-height: var(--leading-normal);
		color: var(--surface-text-muted);
		margin-bottom: var(--space-md);
	}

	.hero__actions {
		display: flex;
		gap: var(--space-xs);
		flex-wrap: wrap;
	}

	.button {
		display: inline-flex;
		align-items: center;
		min-height: 48px;
		padding: 0 var(--space-sm);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
		border-radius: var(--radius-sm);
		border: 1px solid transparent;
		transition:
			background-color var(--duration-cut) var(--ease-cut),
			border-color var(--duration-cut) var(--ease-cut);
	}

	/* Ember fill + graphite text: same pair as ember-on-graphite (5.95:1), just
	   reversed roles, so this button is valid on both dark and light sections. */
	.button--primary {
		background: var(--color-accent);
		color: var(--color-bg);
	}

	.button--primary:hover {
		background: color-mix(in srgb, var(--color-accent) 85%, white);
	}

	.button--secondary {
		border-color: var(--color-line);
		color: var(--color-text);
	}

	.button--secondary:hover {
		border-color: var(--surface-text-muted);
	}

	/* ---- Timeline (signature element) ---- */
	.timeline {
		list-style: none;
		margin: 0;
		padding: 0 0 0 var(--space-md);
		border-left: 2px solid var(--color-accent);
		display: grid;
		gap: var(--space-md);
	}

	.timeline__stage {
		position: relative;
	}

	.timeline__stage::before {
		content: '';
		position: absolute;
		/* -2.8125rem = -(--space-md's 2.5rem + half the 10px dot), centering the
		   marker on the 2px border-left line. Measured live post-deploy and
		   confirmed within 1px of the border's true center. */
		left: -2.8125rem;
		top: 0.35rem;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--color-accent);
	}

	.timeline__stage:nth-child(2)::before {
		background: var(--color-accent-secondary);
	}

	.timeline__stage:nth-child(3)::before {
		background: var(--color-accent-tertiary);
	}

	.timeline__stage:nth-child(4)::before {
		background: var(--surface-text-muted);
	}

	.timeline__code {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: var(--tracking-label);
		color: var(--color-accent);
	}

	.timeline__label {
		font-family: var(--font-sans);
		font-weight: 600;
		margin: var(--space-2xs) 0;
	}

	.timeline__body {
		font-size: 0.9rem;
		color: var(--surface-text-muted);
		max-width: 40ch;
	}

	/* ---- Hero metrics strip (from the approved mockup, previously missing) ---- */
	.hero__metrics {
		max-width: var(--content-max);
		margin: 0 auto;
		padding: var(--space-sm) var(--space-sm) 0;
		border-top: 1px solid var(--color-line);
		list-style: none;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
	}

	.hero__metric {
		padding: var(--space-sm) 0;
	}

	.hero__metric + .hero__metric {
		padding-left: var(--space-sm);
		border-left: 1px solid var(--color-line);
	}

	.hero__metric strong {
		display: block;
		font-family: var(--font-display);
		font-weight: 900;
		font-size: clamp(1.3rem, 1rem + 1.2vw, 2rem);
		letter-spacing: var(--tracking-display);
		text-transform: uppercase;
	}

	.hero__metric span {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--surface-text-muted);
	}

	/* ---- 2. Capabilities (light) ---- */
	.capabilities__heading {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: var(--step-3);
		margin-bottom: var(--space-lg);
	}

	.capabilities__list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--color-line-inverse);
	}

	.capabilities__item {
		display: grid;
		grid-template-columns: 4rem 1fr;
		gap: var(--space-md);
		padding: var(--space-md) 0;
		border-bottom: 1px solid var(--color-line-inverse);
		align-items: baseline;
	}

	.capabilities__n {
		font-family: var(--font-mono);
		font-size: 0.9rem;
		color: var(--surface-text-muted);
	}

	.capabilities__item h3 {
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: var(--step-1);
		margin-bottom: var(--space-2xs);
	}

	.capabilities__item p {
		color: var(--surface-text-muted);
		max-width: 60ch;
	}

	/* ---- 3. Work showcase (dark) ---- */
	.proof {
		border-top: 1px solid var(--color-line);
	}

	.proof__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: var(--space-xs);
		margin-bottom: var(--space-md);
	}

	.proof__head h2 {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: var(--step-3);
	}

	.proof__link {
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 0.85rem;
		text-decoration: none;
		color: var(--color-accent-secondary);
		white-space: nowrap;
	}

	.proof__grid {
		list-style: none;
		margin: 0 0 var(--space-sm);
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-sm);
	}

	.proof__card {
		min-width: 0; /* without this, aspect-ratio + grid's default min-width:auto let this item overflow its 1fr track — confirmed live previously */
		aspect-ratio: 16 / 9;
		background: var(--color-surface);
		border: 1px dashed var(--color-line);
		border-radius: var(--radius-sm);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--space-2xs);
		padding: var(--space-sm);
		text-align: center;
	}

	.proof__card[data-format='1:1'] {
		aspect-ratio: 1 / 1;
	}

	.proof__card[data-format='9:16'] {
		aspect-ratio: 9 / 16;
	}

	.proof__ratio {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--surface-text-muted);
	}

	.proof__pending {
		font-family: var(--font-sans);
		font-size: 0.85rem;
		color: var(--surface-text-muted);
	}

	.proof__note {
		font-size: 0.8rem;
		color: var(--surface-text-muted);
	}

	.proof__note a {
		color: var(--color-accent-secondary);
	}

	/* ---- 4. About teaser (light) ---- */
	.about-teaser__inner {
		border-top: 1px solid var(--color-line-inverse);
	}

	.about-teaser h2 {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: var(--step-3);
		margin-bottom: var(--space-sm);
	}

	.about-teaser__body {
		max-width: 62ch;
		font-size: var(--step-1);
		color: var(--surface-text-muted);
		margin-bottom: var(--space-sm);
	}

	.about-teaser__pending {
		font-size: 0.85rem;
		color: var(--surface-text-muted);
		margin-bottom: var(--space-sm);
	}

	.text-link {
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 0.9rem;
		text-decoration: none;
		color: var(--color-text-inverse);
		border-bottom: 1px solid currentColor;
	}

	/* ---- 5. CTA band (dark) ---- */
	.cta-band {
		max-width: var(--content-max);
		margin-inline: auto;
		padding: var(--space-2xl) var(--space-sm);
		text-align: center;
		display: grid;
		gap: var(--space-sm);
		justify-items: center;
		border-top: 1px solid var(--color-line);
	}

	.cta-band h2 {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: var(--step-3);
		letter-spacing: var(--tracking-display);
		text-transform: uppercase;
		max-width: 22ch;
	}

	.cta-band p {
		max-width: 48ch;
		color: var(--surface-text-muted);
	}

	@media (max-width: 860px) {
		.hero__grid {
			grid-template-columns: 1fr;
		}

		.proof__grid {
			grid-template-columns: 1fr 1fr;
		}

		.proof__grid li:nth-child(3) {
			grid-column: 1 / -1;
		}

		.capabilities__item {
			grid-template-columns: 1fr;
			gap: var(--space-2xs);
		}
	}

	@media (max-width: 640px) {
		.hero__metrics {
			grid-template-columns: 1fr;
		}

		.hero__metric + .hero__metric {
			padding-left: 0;
			border-left: 0;
			border-top: 1px solid var(--color-line);
		}
	}

	@media (max-width: 520px) {
		.proof__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
