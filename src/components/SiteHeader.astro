---
// Base-aware internal links per instructions.md: GitHub Pages serves this project
// from /creatersden-site/, so every internal href must be prefixed with the
// configured `base`, never hardcoded, so it keeps working if the repo is renamed.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navItems = [
	{ label: 'Work', href: `${base}/work/` },
	{ label: 'Services', href: `${base}/services/` },
	{ label: 'Process', href: `${base}/process/` },
	{ label: 'Estimate', href: `${base}/estimate/` },
	{ label: 'About', href: `${base}/about/` },
	{ label: 'Contact', href: `${base}/contact/` },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
	<div class="site-header__inner">
		<a class="site-header__mark" href={`${base}/`}>
			<span aria-hidden="true">CREATERSDEN</span>
			<span class="sr-only">CreatersDen — home</span>
		</a>
		<nav class="site-header__nav" aria-label="Primary">
			<ul>
				{
					navItems.map((item) => {
						const isCurrent = currentPath === item.href || currentPath === item.href.replace(/\/$/, '');
						return (
							<li>
								<a href={item.href} aria-current={isCurrent ? 'page' : undefined}>
									{item.label}
								</a>
							</li>
						);
					})
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		background: color-mix(in srgb, var(--color-bg) 92%, transparent);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--color-line);
	}

	.site-header__inner {
		max-width: var(--content-max);
		margin-inline: auto;
		padding: var(--space-sm) var(--space-sm);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
	}

	.site-header__mark {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: 1.1rem;
		letter-spacing: var(--tracking-display);
		text-transform: uppercase;
		text-decoration: none;
		white-space: nowrap;
	}

	.site-header__nav ul {
		display: flex;
		gap: var(--space-sm);
		list-style: none;
		margin: 0;
		padding: 0;
		flex-wrap: wrap;
	}

	.site-header__nav a {
		display: inline-block;
		padding: var(--space-2xs) 0;
		font-family: var(--font-sans);
		font-weight: 500;
		font-size: 0.85rem;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		text-decoration: none;
		border-bottom: 2px solid transparent;
	}

	.site-header__nav a:hover {
		border-bottom-color: var(--color-line);
	}

	.site-header__nav a[aria-current='page'] {
		color: var(--color-accent);
		border-bottom-color: var(--color-accent);
	}

	@media (max-width: 640px) {
		.site-header__inner {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--space-xs);
		}

		.site-header__nav ul {
			gap: var(--space-xs) var(--space-sm);
		}
	}
</style>
