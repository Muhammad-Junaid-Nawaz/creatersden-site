---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();

const footerNav = [
	{ label: 'Work', href: `${base}/work/` },
	{ label: 'Services', href: `${base}/services/` },
	{ label: 'Process', href: `${base}/process/` },
	{ label: 'Estimate', href: `${base}/estimate/` },
	{ label: 'About', href: `${base}/about/` },
	{ label: 'Contact', href: `${base}/contact/` },
];
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<div class="site-footer__mark">
			<span aria-hidden="true">CREATERSDEN</span>
			<span class="sr-only">CreatersDen</span>
		</div>

		<nav class="site-footer__nav" aria-label="Footer">
			<ul>
				{
					footerNav.map((item) => (
						<li>
							<a href={item.href}>{item.label}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<!--
			No email, phone, or social links here: instructions.md forbids inventing
			contact destinations. PROJECT.md > Content inventory lists these as still
			needed. The /contact/ route is the honest single path until real details
			arrive — do not add placeholder mailto/tel/social hrefs to fill this gap.
		-->
		<p class="site-footer__legal">© {year} CreatersDen. Site in development.</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-line);
		margin-top: var(--space-2xl);
	}

	.site-footer__inner {
		max-width: var(--content-max);
		margin-inline: auto;
		padding: var(--space-lg) var(--space-sm) var(--space-md);
		display: grid;
		gap: var(--space-md);
	}

	.site-footer__mark {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: 1.1rem;
		letter-spacing: var(--tracking-display);
		text-transform: uppercase;
	}

	.site-footer__nav ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs) var(--space-md);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.site-footer__nav a {
		font-family: var(--font-sans);
		font-size: 0.85rem;
		font-weight: 500;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-text-muted);
	}

	.site-footer__nav a:hover {
		color: var(--color-text);
	}

	.site-footer__legal {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-text-muted);
	}
</style>
